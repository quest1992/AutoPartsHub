generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SHOP_ADMIN
  MANAGER
  SELLER
  VIEWER
}

enum PartSide {
  NONE
  LEFT
  RIGHT
}

enum PartPosition {
  NONE
  FRONT
  REAR
}

enum PartCategoryClassification {
  CATEGORY
  CATALOG_ITEM
  INVALID
  REVIEW
}

enum PartTaxonomyDecisionStatus {
  DRAFT
  READY
  APPROVED
  APPLYING
  APPLIED
  FAILED
  CANCELLED
}

enum PartTaxonomyRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PartTaxonomyDuplicateStrategy {
  CREATE_NEW
  USE_EXISTING
  MERGE_WITH_EXISTING
  KEEP_SEPARATE
  REQUIRE_REVIEW
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

enum PartNumberType {
  OEM
  CROSS
  AFTERMARKET
  INTERNAL
}

enum PartBrandType {
  OEM
  OES
  AFTERMARKET
  PREMIUM
  BUDGET
  PERFORMANCE
  EV
  MOTORCYCLE
  TRUCK
  BUS
  INDUSTRIAL
}

enum PartBrandStatus {
  ACTIVE
  INACTIVE
  HISTORIC
  UNKNOWN
}

enum PartBrandAliasType {
  ALTERNATIVE_NAME
  ABBREVIATION
  TRADE_NAME
  PREVIOUS_NAME
}

enum OemPartStatus {
  ACTIVE
  DISCONTINUED
  SUPERSEDED
  UNKNOWN
}

enum OemPartAliasType {
  FORMATTING
  OLD_NUMBER
  REPLACED_NUMBER
  SUPERSESSION
  REGIONAL
  SUPPLIER
  MANUAL
}

enum OemSourceType {
  OPEN_DATA
  MANUFACTURER
  SUPPLIER
  SHOP
  MANUAL_ENTRY
  CSV_IMPORT
  API
  COMMERCIAL_LICENSE
  UNKNOWN
}

enum OemPartBrandRelationType {
  VEHICLE_MANUFACTURER
  ORIGINAL_SUPPLIER
  OES
  AFTERMARKET
  PACKAGING_BRAND
  UNKNOWN
}

enum OemFitmentPosition {
  FRONT
  REAR
  LEFT
  RIGHT
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
  INNER
  OUTER
  UPPER
  LOWER
  CENTER
  NOT_APPLICABLE
  UNKNOWN
}

enum OemCrossReferenceType {
  REPLACEMENT
  SUPERSESSION
  PREDECESSOR
  SUCCESSOR
  INTERCHANGE
  AFTERMARKET_ANALOG
  OES_EQUIVALENT
  POSSIBLE_MATCH
}

enum OemImportBatchStatus {
  PLANNED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum OemContributionType {
  NEW_OEM
  NEW_ALIAS
  CATEGORY_MAPPING
  FITMENT
  CROSS_REFERENCE
  CORRECTION
}

enum OemContributionStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

enum InventoryMovementType {
  INITIAL_BALANCE
  IMPORT
  STOCK_IN
  SALE
  SALE_CANCEL
  PURCHASE
  PURCHASE_CANCEL
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
}

enum CustomerOrderStatus {
  DRAFT
  RESERVED
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderDeliveryType {
  PICKUP
  DELIVERY
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderItemReservationStatus {
  NOT_RESERVED
  RESERVED
  RELEASED
  CONVERTED_TO_SALE
}

enum OrderCommissionType {
  MARKUP
  PERCENT
  FIXED
  MANUAL
}

enum ShopCommissionType {
  MARKUP
  PERCENT
  FIXED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  OTHER
}

enum PaymentTransactionStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ShopPayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PayoutMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum ShopPayoutStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Shop {
  id String @id @default(uuid())

  name      String
  ownerName String?

  phone    String?
  whatsapp String?
  email    String?

  country String?
  city    String?
  address String?

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true)

  users                     User[]
  inventoryItems            ShopInventoryItem[]
  inventoryMovements        InventoryMovement[]
  inventoryImportJobs       InventoryImportJob[]
  inventoryImportSessions   InventoryImportSession[]
  catalogModerationRequests CatalogModerationRequest[]
  partCatalogSuggestions    PartCatalogSuggestion[]
  sales                     Sale[]
  purchases                 Purchase[]
  warehouses                ShopWarehouse[]
  inventoryTransfers        InventoryTransfer[]
  stocktakes                Stocktake[]
  customers                 Customer[]
  customerOrderItems        CustomerOrderItem[]
  commissionSetting         ShopCommissionSetting?
  payables                  ShopPayable[]
  payouts                   ShopPayout[]
  oemContributions          OemContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([city])
}

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  phone String  @unique
  email String? @unique

  passwordHash String

  role UserRole @default(SELLER)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  inventoryMovements              InventoryMovement[]
  salesCreated                    Sale[]                           @relation("SaleCreatedBy")
  salesCancelled                  Sale[]                           @relation("SaleCancelledBy")
  purchasesCreated                Purchase[]                       @relation("PurchaseCreatedBy")
  purchasesCancelled              Purchase[]                       @relation("PurchaseCancelledBy")
  inventoryImportJobs             InventoryImportJob[]             @relation("InventoryImportCreatedBy")
  inventoryImportSessions         InventoryImportSession[]
  inventoryTransfersCreated       InventoryTransfer[]
  stocktakesCreated               Stocktake[]
  customersCreated                Customer[]                       @relation("CustomerCreatedBy")
  customerOrdersCreated           CustomerOrder[]                  @relation("CustomerOrderCreatedBy")
  customerOrdersConfirmed         CustomerOrder[]                  @relation("CustomerOrderConfirmedBy")
  customerOrdersCancelled         CustomerOrder[]                  @relation("CustomerOrderCancelledBy")
  customerOrderStatusHistory      CustomerOrderStatusHistory[]
  customerOrderPaymentsReceived   CustomerOrderPayment[]           @relation("PaymentReceivedBy")
  customerOrderPaymentsCancelled  CustomerOrderPayment[]           @relation("PaymentCancelledBy")
  shopPayoutsCreated              ShopPayout[]                     @relation("PayoutCreatedBy")
  shopPayoutsCancelled            ShopPayout[]                     @relation("PayoutCancelledBy")
  moderationRequestsResolved      CatalogModerationRequest[]       @relation("CatalogModerationResolvedBy")
  catalogSuggestionsCreated       PartCatalogSuggestion[]          @relation("CatalogSuggestionCreatedBy")
  catalogSuggestionsResolved      PartCatalogSuggestion[]          @relation("CatalogSuggestionResolvedBy")
  vehicleDataChanges              VehicleDataChange[]
  partCategoryCatalogItemMappings PartCategoryCatalogItemMapping[]
  taxonomyDecisionsCreated        PartTaxonomyDecision[]           @relation("TaxonomyDecisionCreatedBy")
  taxonomyDecisionsApproved       PartTaxonomyDecision[]           @relation("TaxonomyDecisionApprovedBy")
  taxonomyDecisionsApplied        PartTaxonomyDecision[]           @relation("TaxonomyDecisionAppliedBy")
  taxonomyAuditEvents             PartTaxonomyAuditEvent[]
  oemImportBatches                OemImportBatch[]
  oemContributionsSubmitted       OemContribution[]                @relation("OemContributionSubmittedBy")
  oemContributionsReviewed        OemContribution[]                @relation("OemContributionReviewedBy")
  oemAuditLogs                    OemAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([role])
  @@index([isActive])
}

model Category {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@index([parentId])
  @@index([isActive])
}

model Manufacturer {
  id String @id @default(uuid())

  name             String                   @unique
  englishName      String?
  chineseName      String?
  pinyin           String?
  slug             String                   @unique
  country          String?
  city             String?
  foundedYear      Int?
  parentCompany    String?
  manufacturerType VehicleManufacturerType?
  website          String?
  logo             String?
  description      String?
  sourceRefs       String[]                 @default([])

  vehicleModels   VehicleModel[]
  engines         Engine[]
  oemParts        OemPart[]
  oemPartFitments OemPartFitment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([manufacturerType])
}

model VehicleModel {
  id String @id @default(uuid())

  name           String
  slug           String
  description    String?
  internalCode   String?
  startYear      Int?
  endYear        Int?
  vehicleType    String?
  chineseName    String?
  exportName     String?
  bodyStyle      String?
  segment        String?
  series         String?
  vehicleClass   String?
  doors          Int?
  seats          Int?
  powertrainType VehiclePowertrainType?
  platform       String?
  bodyCode       String?
  exportIndex    String?
  sourceRefs     String[]               @default([])

  manufacturerId  String
  manufacturer    Manufacturer           @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  generations     VehicleGeneration[]
  specifications  VehicleSpecification[]
  oemPartFitments OemPartFitment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manufacturerId, name])
  @@unique([manufacturerId, slug])
  @@index([manufacturerId])
  @@index([isActive])
  @@index([startYear])
  @@index([endYear])
  @@index([vehicleType])
  @@index([powertrainType])
}

model VehicleGeneration {
  id String @id @default(uuid())

  name        String
  slug        String
  description String?
  code        String?
  displayName String?
  notes       String?
  platform    String?
  bodyCode    String?
  exportIndex String?
  sourceRefs  String[] @default([])

  vehicleModelId  String
  vehicleModel    VehicleModel           @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)
  compatibilities PartCompatibility[]
  engines         Engine[]
  modifications   VehicleModification[]
  inventoryItems  ShopInventoryItem[]
  specifications  VehicleSpecification[]
  oemPartFitments OemPartFitment[]

  startYear  Int?
  endYear    Int?
  isFacelift Boolean               @default(false)
  kind       VehicleGenerationKind @default(GENERATION)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleModelId, slug])
  @@index([vehicleModelId])
  @@index([isActive])
  @@index([startYear])
  @@index([endYear])
  @@index([kind])
}

enum VehicleGenerationKind {
  GENERATION
  MODEL_YEAR
}

enum VehicleManufacturerType {
  STATE_OWNED
  PRIVATE
  JOINT_VENTURE
  SUBBRAND
  EXPORT_BRAND
  COMMERCIAL
  HISTORIC
  OTHER
}

enum VehiclePowertrainType {
  ICE
  MHEV
  HEV
  PHEV
  BEV
  EREV
  FCEV
  UNKNOWN
}

model VehicleSpecification {
  id String @id @default(uuid())

  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Restrict)

  generationId String?
  generation   VehicleGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)

  sourceKey String  @unique
  specHash  String  @unique
  year      Int
  trim      String?
  variant   String?

  powertrainType   VehiclePowertrainType
  driveType        String?
  transmissionType String?

  engineCode           String?
  engineDisplacementCc Int?
  engineTurbo          Boolean?
  engineCylinders      Int?
  enginePowerKw        Decimal? @db.Decimal(10, 3)
  engineTorqueNm       Decimal? @db.Decimal(10, 3)

  motorCount     Int?
  motorPowerKw   Decimal? @db.Decimal(10, 3)
  motorTorqueNm  Decimal? @db.Decimal(10, 3)
  motorPositions String[] @default([])

  batteryManufacturer String?
  batteryChemistry    String?
  batteryGrossKwh     Decimal? @db.Decimal(10, 3)
  batteryUsableKwh    Decimal? @db.Decimal(10, 3)

  rangeCltcKm Decimal? @db.Decimal(10, 3)
  rangeWltpKm Decimal? @db.Decimal(10, 3)
  rangeEpaKm  Decimal? @db.Decimal(10, 3)
  rangeNedcKm Decimal? @db.Decimal(10, 3)
  rangeData   Json

  acChargeKw       Decimal? @db.Decimal(10, 3)
  dcChargeKw       Decimal? @db.Decimal(10, 3)
  chargeConnectors String[] @default([])

  platform      String?
  bodyCode      String?
  internalIndex String?
  doors         Int?
  seats         Int?

  sourceTitle       String
  sourceUrl         String
  sourceRetrievedAt DateTime
  sourceLicense     String
  sources           Json

  oemPartFitments OemPartFitment[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleModelId])
  @@index([generationId])
  @@index([year])
  @@index([powertrainType])
  @@index([batteryManufacturer])
  @@index([platform])
  @@index([isActive])
}

model Engine {
  id String @id @default(uuid())

  generationId String?
  generation   VehicleGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)

  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  fuelTypeId String
  fuelType   FuelType @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)

  code             String
  name             String
  volume           Decimal? @db.Decimal(4, 2)
  fuel             String
  power            Int?
  displacementCC   Int?
  cylinders        Int?
  horsepower       Int?
  torque           Int?
  turbo            Boolean  @default(false)
  aspiration       String?
  valveCount       Int?
  emissionStandard String?
  notes            String?

  isActive      Boolean               @default(true)
  fitments      VehicleFitment[]
  modifications VehicleModification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([manufacturerId, code])
  @@index([generationId])
  @@index([manufacturerId])
  @@index([fuelTypeId])
  @@index([code])
  @@index([displacementCC])
  @@index([horsepower])
  @@index([fuel])
  @@index([isActive])
}

model BodyType {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model FuelType {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  engines       Engine[]
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model DriveType {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model TransmissionType {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model SteeringPosition {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model MarketRegion {
  id            String                @id @default(uuid())
  name          String                @unique
  slug          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  modifications VehicleModification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([isActive])
}

model VehicleModification {
  id String @id @default(uuid())

  generationId       String
  generation         VehicleGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  bodyTypeId         String
  bodyType           BodyType          @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)
  engineId           String
  engine             Engine            @relation(fields: [engineId], references: [id], onDelete: Restrict)
  transmissionTypeId String
  transmissionType   TransmissionType  @relation(fields: [transmissionTypeId], references: [id], onDelete: Restrict)
  driveTypeId        String
  driveType          DriveType         @relation(fields: [driveTypeId], references: [id], onDelete: Restrict)
  fuelTypeId         String
  fuelType           FuelType          @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)
  steeringPositionId String
  steeringPosition   SteeringPosition  @relation(fields: [steeringPositionId], references: [id], onDelete: Restrict)
  marketRegionId     String
  marketRegion       MarketRegion      @relation(fields: [marketRegionId], references: [id], onDelete: Restrict)

  productionFrom Int?
  productionTo   Int?
  doors          Int?
  powerKW        Int?
  powerHP        Int?
  vinFrom        String?
  vinTo          String?
  remarks        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([generationId, bodyTypeId, engineId, transmissionTypeId, driveTypeId, steeringPositionId, marketRegionId, productionFrom, productionTo])
  @@index([generationId])
  @@index([engineId])
  @@index([bodyTypeId])
  @@index([transmissionTypeId])
  @@index([driveTypeId])
  @@index([fuelTypeId])
  @@index([steeringPositionId])
  @@index([marketRegionId])
  @@index([productionFrom, productionTo])
  @@index([isActive])
}

model VehicleDataChange {
  id          String                   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  changedById String
  changedBy   User                     @relation(fields: [changedById], references: [id], onDelete: Restrict)
  fields      VehicleDataChangeField[]
  createdAt   DateTime                 @default(now())

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([createdAt])
}

model VehicleDataChangeField {
  id        String            @id @default(uuid())
  changeId  String
  change    VehicleDataChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  fieldName String
  oldValue  String?
  newValue  String?

  @@index([changeId])
}

model PartCategory {
  id String @id @default(uuid())

  name        String
  slug        String
  description String?

  parentId                String?
  parent                  PartCategory?                    @relation("PartCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                PartCategory[]                   @relation("PartCategoryHierarchy")
  partCatalogItems        PartCatalogItem[]
  suggestedForModeration  CatalogModerationRequest[]       @relation("CatalogModerationSuggestedCategory")
  partCatalogSuggestions  PartCatalogSuggestion[]          @relation("CatalogSuggestionSuggestedCategory")
  catalogItemMappings     PartCategoryCatalogItemMapping[]
  taxonomySourceDecisions PartTaxonomyDecision[]           @relation("TaxonomyDecisionSource")
  taxonomyTargetDecisions PartTaxonomyDecision[]           @relation("TaxonomyDecisionTargetCategory")

  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  needsReview Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

model AppSequence {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model PartCatalogItem {
  id             String  @id @default(uuid())
  internalCode   String  @unique
  name           String
  normalizedName String
  searchTokens   String
  slug           String
  description    String?

  categoryId String
  category   PartCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  side        PartSide     @default(NONE)
  position    PartPosition @default(NONE)
  isUniversal Boolean      @default(false)
  isActive    Boolean      @default(true)

  compatibilities PartCompatibility[]
  vehicleFitments VehicleFitment[]

  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  shopInventoryItems     ShopInventoryItem[]
  saleItems              SaleItem[]
  purchaseItems          PurchaseItem[]
  partNumbers            PartNumber[]
  aliases                PartAlias[]
  partCatalogSuggestions PartCatalogSuggestion[]          @relation("CatalogSuggestionMergedInto")
  inventoryTransferItems InventoryTransferItem[]
  customerOrderItems     CustomerOrderItem[]
  categoryMappings       PartCategoryCatalogItemMapping[]
  taxonomyDecisions      PartTaxonomyDecision[]
  oemPartCategories      OemPartCategory[]

  replacedById String?
  replacedBy   PartCatalogItem?  @relation("PartCatalogItemReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replacements PartCatalogItem[] @relation("PartCatalogItemReplacement")

  @@unique([categoryId, slug, side, position])
  @@index([categoryId])
  @@index([isActive])
  @@index([isUniversal])
  @@index([side])
  @@index([position])
  @@index([replacedById])
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "PartCatalogItem_normalizedName_trgm_idx")
  @@index([searchTokens(ops: raw("gin_trgm_ops"))], type: Gin, map: "PartCatalogItem_searchTokens_trgm_idx")
  @@index([categoryId, side, position, normalizedName])
}

model PartCategoryCatalogItemMapping {
  id                  String                     @id @default(uuid())
  sourceCategoryId    String
  targetCatalogItemId String?
  migrationKey        String                     @unique
  classification      PartCategoryClassification
  canonicalName       String
  notes               String?
  createdById         String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  sourceCategory    PartCategory     @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict)
  targetCatalogItem PartCatalogItem? @relation(fields: [targetCatalogItemId], references: [id], onDelete: Restrict)
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceCategoryId, targetCatalogItemId])
  @@index([sourceCategoryId])
  @@index([targetCatalogItemId])
  @@index([classification])
  @@index([createdById])
}

model PartTaxonomyDecision {
  id                  String                         @id @default(uuid())
  sourceCategoryId    String
  classification      PartCategoryClassification
  targetCategoryId    String?
  targetCatalogItemId String?
  canonicalName       String?
  canonicalSlug       String?
  side                PartSide                       @default(NONE)
  position            PartPosition                   @default(NONE)
  unit                String?
  aliases             Json?
  duplicateStrategy   PartTaxonomyDuplicateStrategy?
  deactivateSource    Boolean                        @default(true)
  status              PartTaxonomyDecisionStatus     @default(DRAFT)
  riskLevel           PartTaxonomyRiskLevel          @default(MEDIUM)
  notes               String?
  reviewReason        String?
  errorMessage        String?
  createdById         String
  approvedById        String?
  appliedById         String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  approvedAt          DateTime?
  appliedAt           DateTime?

  sourceCategory    PartCategory     @relation("TaxonomyDecisionSource", fields: [sourceCategoryId], references: [id], onDelete: Restrict)
  targetCategory    PartCategory?    @relation("TaxonomyDecisionTargetCategory", fields: [targetCategoryId], references: [id], onDelete: Restrict)
  targetCatalogItem PartCatalogItem? @relation(fields: [targetCatalogItemId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("TaxonomyDecisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy        User?            @relation("TaxonomyDecisionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  appliedBy         User?            @relation("TaxonomyDecisionAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)

  @@index([sourceCategoryId])
  @@index([targetCategoryId])
