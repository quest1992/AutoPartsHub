  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([reservationExpiresAt])
}

model CustomerOrderItem {
  id                String                     @id @default(uuid())
  orderId           String
  inventoryItemId   String
  shopId            String
  warehouseId       String
  catalogItemId     String
  quantity          Int
  unitPrice         Decimal                    @db.Decimal(14, 2)
  discount          Decimal                    @default(0) @db.Decimal(14, 2)
  total             Decimal                    @db.Decimal(14, 2)
  shopUnitPrice     Decimal                    @db.Decimal(14, 2)
  clientUnitPrice   Decimal                    @db.Decimal(14, 2)
  grossAmount       Decimal                    @db.Decimal(14, 2)
  discountAmount    Decimal                    @default(0) @db.Decimal(14, 2)
  clientAmount      Decimal                    @db.Decimal(14, 2)
  shopAmount        Decimal                    @db.Decimal(14, 2)
  platformRevenue   Decimal                    @db.Decimal(14, 2)
  commissionType    OrderCommissionType        @default(MANUAL)
  commissionValue   Decimal                    @default(0) @db.Decimal(14, 2)
  catalogItemName   String
  shopName          String
  warehouseName     String
  article           String?
  oem               String?
  brand             String?
  reservationStatus OrderItemReservationStatus @default(NOT_RESERVED)
  createdAt         DateTime                   @default(now())
  order             CustomerOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  inventoryItem     ShopInventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  shop              Shop                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  warehouse         ShopWarehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  catalogItem       PartCatalogItem            @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inventoryItemId])
  @@index([shopId])
  @@index([warehouseId])
}

model CustomerOrderStatusHistory {
  id        String              @id @default(uuid())
  orderId   String
  status    CustomerOrderStatus
  userId    String?
  note      String?
  createdAt DateTime            @default(now())
  order     CustomerOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model ShopCommissionSetting {
  id              String             @id @default(uuid())
  shopId          String             @unique
  commissionType  ShopCommissionType
  commissionValue Decimal            @db.Decimal(14, 2)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
}

model PlatformOrderSetting {
  id                     String             @id @default(uuid())
  defaultCommissionType  ShopCommissionType
  defaultCommissionValue Decimal            @db.Decimal(14, 2)
  reservationMinutes     Int                @default(120)
  currencyCode           String             @default("TJS")
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model CustomerOrderPayment {
  id                   String                   @id @default(uuid())
  orderId              String
  amount               Decimal                  @db.Decimal(14, 2)
  method               PaymentMethod
  status               PaymentTransactionStatus @default(COMPLETED)
  originalPaymentId    String?
  transactionReference String?
  note                 String?
  receivedById         String
  receivedAt           DateTime
  cancelledAt          DateTime?
  cancelledById        String?
  cancelReason         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  order                CustomerOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedBy           User                     @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy          User?                    @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  originalPayment      CustomerOrderPayment?    @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds              CustomerOrderPayment[]   @relation("PaymentRefunds")

  @@index([orderId, status])
  @@index([receivedAt])
  @@index([originalPaymentId])
}

model ShopPayable {
  id              String                 @id @default(uuid())
  shopId          String
  customerOrderId String
  saleId          String                 @unique
  grossShopAmount Decimal                @db.Decimal(14, 2)
  adjustments     Decimal                @default(0) @db.Decimal(14, 2)
  payableAmount   Decimal                @db.Decimal(14, 2)
  paidAmount      Decimal                @default(0) @db.Decimal(14, 2)
  status          ShopPayableStatus      @default(PENDING)
  dueAt           DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  shop            Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customerOrder   CustomerOrder          @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)
  sale            Sale                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations     ShopPayoutAllocation[]

  @@index([shopId, status])
  @@index([customerOrderId])
}

model ShopPayout {
  id                   String                 @id @default(uuid())
  number               String                 @unique
  shopId               String
  amount               Decimal                @db.Decimal(14, 2)
  method               PayoutMethod
  status               ShopPayoutStatus       @default(DRAFT)
  transactionReference String?
  note                 String?
  createdById          String
  paidAt               DateTime?
  cancelledAt          DateTime?
  cancelledById        String?
  cancelReason         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shop                 Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  createdBy            User                   @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy          User?                  @relation("PayoutCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  allocations          ShopPayoutAllocation[]

  @@index([shopId, status])
}

model ShopPayoutAllocation {
  id        String      @id @default(uuid())
  payoutId  String
  payableId String
  amount    Decimal     @db.Decimal(14, 2)
  payout    ShopPayout  @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payable   ShopPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)

  @@unique([payoutId, payableId])
  @@index([payableId])
}

model ShopWarehouse {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  code      String?
  address   String?
  note      String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryItems     ShopInventoryItem[]
  movements          InventoryMovement[]
  transfersFrom      InventoryTransfer[] @relation("TransferFromWarehouse")
  transfersTo        InventoryTransfer[] @relation("TransferToWarehouse")
  stocktakes         Stocktake[]
  customerOrderItems CustomerOrderItem[]

  @@unique([shopId, name])
  @@unique([shopId, code])
  @@index([shopId, isActive])
  @@map("shop_warehouses")
}

enum StocktakeStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Stocktake {
  id          String          @id @default(uuid())
  shopId      String
  warehouseId String
  number      String
  status      StocktakeStatus @default(DRAFT)
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  cancelledAt DateTime?

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  warehouse ShopWarehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     StocktakeItem[]

  @@unique([shopId, number])
  @@index([shopId, createdAt])
  @@index([warehouseId, status])
}

model StocktakeItem {
  id               String @id @default(uuid())
  stocktakeId      String
  inventoryItemId  String
  expectedQuantity Int
  actualQuantity   Int?
  difference       Int?

  stocktake     Stocktake         @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  inventoryItem ShopInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, inventoryItemId])
  @@index([inventoryItemId])
}

enum InventoryTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryTransfer {
  id              String                  @id @default(uuid())
  shopId          String
  number          String
  fromWarehouseId String
  toWarehouseId   String
  status          InventoryTransferStatus @default(DRAFT)
  note            String?
  createdById     String
  createdAt       DateTime                @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?

  shop          Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  fromWarehouse ShopWarehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   ShopWarehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  createdBy     User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items         InventoryTransferItem[]

  @@unique([shopId, number])
  @@index([shopId, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model InventoryTransferItem {
  id                    String        @id @default(uuid())
  transferId            String
  catalogItemId         String
  sourceInventoryItemId String?
  quantity              Int
  catalogItemName       String
  article               String?
  oem                   String?
  manufacturer          String?
  condition             PartCondition @default(NEW)

  transfer            InventoryTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  catalogItem         PartCatalogItem    @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  sourceInventoryItem ShopInventoryItem? @relation(fields: [sourceInventoryItemId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([catalogItemId])
  @@index([sourceInventoryItemId])
}

model InventoryImportJob {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  fileName String
  status   InventoryImportJobStatus @default(PROCESSING)

  totalRows          Int @default(0)
  importedRows       Int @default(0)
  updatedRows        Int @default(0)
  skippedRows        Int @default(0)
  failedRows         Int @default(0)
  requiresReviewRows Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdByUserId    String?
  createdBy          User?                      @relation("InventoryImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  moderationRequests CatalogModerationRequest[]

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@index([createdByUserId])
}

model InventoryImportSession {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status      InventoryImportStatus @default(PREVIEW)
  fileName    String
  totalRows   Int
  previewData Json
  resultData  Json?
  expiresAt   DateTime
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([shopId, status])
  @@index([userId])
  @@index([expiresAt])
}

model CatalogModerationRequest {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  inventoryItemId String
  inventoryItem   ShopInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  importJobId String?
  importJob   InventoryImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  requestedCategoryName    String?
  requestedSubcategoryName String?

  suggestedCategoryId String?
  suggestedCategory   PartCategory? @relation("CatalogModerationSuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)

  status CatalogModerationStatus @default(PENDING)
  reason String?

  resolvedByUserId String?
  resolvedBy       User?     @relation("CatalogModerationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([inventoryItemId])
  @@index([importJobId])
  @@index([suggestedCategoryId])
  @@index([resolvedByUserId])
  @@index([createdAt])
}
