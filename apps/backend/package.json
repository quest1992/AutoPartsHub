{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "reset:super-admin-password": "tsx prisma/reset-super-admin-password.ts",
    "seed:super-admin": "ts-node prisma/seed-super-admin.ts",
    "seed:part-categories": "tsx prisma/seed-ev-categories.ts",
    "seed:catalog-categories": "tsx prisma/seed-catalog-categories.ts",
    "seed:ev-categories": "npm run seed:part-categories",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run test:e2e:migrate && jest --config ./test/jest-e2e.json",
    "test:e2e:migrate": "tsx scripts/migrate-e2e.ts",
    "test:migrations:fresh": "tsx scripts/verify-migrations-fresh.ts",
    "test:migrations:snapshot": "tsx scripts/verify-migrations-snapshot.ts",
    "catalog:migrate-bms": "tsx scripts/migrate-bms-catalog-taxonomy.ts",
    "catalog:v2:plan": "tsx prisma/catalog-v2.seed.ts",
    "catalog:v2:apply": "tsx prisma/catalog-v2.seed.ts --apply",
    "catalog:v2:report": "tsx scripts/generate-catalog-v2-report.ts",
    "catalog:v2:verify": "tsx scripts/verify-catalog-v2-live.ts",
    "catalog:v2:purge-archive": "tsx scripts/purge-archived-catalog.ts",
    "vehicle-db:plan": "tsx prisma/vehicle-database.seed.ts",
    "vehicle-db:apply": "tsx prisma/vehicle-database.seed.ts --apply",
    "china-vehicle-db:plan": "tsx prisma/china-vehicle-database.seed.ts",
    "china-vehicle-db:apply": "tsx prisma/china-vehicle-database.seed.ts --apply",
    "china-vehicle-specs:plan": "tsx prisma/china-vehicle-specifications.seed.ts",
    "china-vehicle-specs:apply": "tsx prisma/china-vehicle-specifications.seed.ts --apply",
    "tajikistan-ev-market:plan": "tsx prisma/tajikistan-ev-market.seed.ts",
    "tajikistan-ev-market:apply": "tsx prisma/tajikistan-ev-market.seed.ts --apply",
    "tajikistan-ev-market-v2:plan": "tsx prisma/tajikistan-ev-market-v2.seed.ts",
    "tajikistan-ev-market-v2:apply": "tsx prisma/tajikistan-ev-market-v2.seed.ts --apply",
    "byd-models:plan": "tsx prisma/byd-model-coverage.seed.ts",
    "byd-models:apply": "tsx prisma/byd-model-coverage.seed.ts --apply",
    "byd-cleanup:plan": "tsx scripts/byd-vehicle-cleanup.ts",
    "byd-cleanup:apply": "tsx scripts/byd-vehicle-cleanup.ts --apply",
    "part-brands:plan": "tsx prisma/part-brands.seed.ts",
    "part-brands:apply": "tsx prisma/part-brands.seed.ts --apply",
    "part-brands:curated:plan": "tsx prisma/part-brands.seed.ts --curated-only",
    "part-brands:curated:apply": "tsx prisma/part-brands.seed.ts --curated-only --apply",
    "oem-db:plan": "tsx prisma/oem-database.seed.ts",
    "oem-db:apply": "tsx prisma/oem-database.seed.ts --apply",
    "db:backup": "tsx scripts/backup-database.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
